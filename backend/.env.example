# 雀跃 HueJoy 供应商密钥示例
# 用法：复制为 .env 并填入真实密钥；.env 已在 .gitignore 中，永不入库
# 规则：环境变量覆盖 config.yaml 同名配置；.env 是密钥唯一真源
# 命名：<供应商>_API_KEY / <供应商>_BASE_URL / <供应商>_ENABLE_PROXY（可灵用 ACCESS_KEY/SECRET_KEY）

# 阿里云百炼 DashScope（qwen / seedream）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# 火山方舟 Ark（seedance）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 硅基流动 TokenPlus（当前唯一可用通道：文本 + 多模态）
TOKENPLUS_API_KEY=
TOKENPLUS_BASE_URL=https://api.tokenplus.cn/v1

# MiniMax（视频 / 配音 / 对话）
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# 以下按需开通后填入
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_BASE_URL=https://api.klingai.com
